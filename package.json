	"version": "1.0.41",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-guidance.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"gen:guidance": "node scripts/gen-guidance.mjs",
		"mcp:install": "node scripts/mcp-install.js",
		"mcp:inspect": "npx @modelcontextprotocol/inspector node mcp-server/build/index.js",
		"mcp:pack": "node scripts/mcp-pack.js",
		"mcp:release": "node scripts/mcp-release.js"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
